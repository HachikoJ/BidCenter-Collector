{
  "manifest_version": 3,
  "name": "采招网采集助手",
  "version": "1.9.49",
  "description": "在用户已登录的采招网页面中按关键词采集公开可见的招投标信息。",
  "homepage_url": "https://github.com/HachikoJ/BidCenter-Collector",
  "permissions": ["storage", "tabs", "downloads", "unlimitedStorage", "scripting", "alarms", "sidePanel"],
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "host_permissions": ["http://www.bidcenter.com.cn/*", "https://www.bidcenter.com.cn/*", "http://search.bidcenter.com.cn/*", "https://search.bidcenter.com.cn/*", "http://user.bidcenter.com.cn/*", "https://user.bidcenter.com.cn/*", "http://shuju.bidcenter.com.cn/*", "https://shuju.bidcenter.com.cn/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "打开采招网采集助手", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" } },
  "side_panel": { "default_path": "sidepanel.html" },
  "content_scripts": [
    {
      "matches": ["http://www.bidcenter.com.cn/*", "https://www.bidcenter.com.cn/*", "http://search.bidcenter.com.cn/*", "https://search.bidcenter.com.cn/*", "http://user.bidcenter.com.cn/*", "https://user.bidcenter.com.cn/*", "http://shuju.bidcenter.com.cn/*", "https://shuju.bidcenter.com.cn/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
